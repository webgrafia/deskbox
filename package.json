{
  "name": "deskbox",
  "version": "1.0.0",
  "description": "Lightweight workspace for Gmail, Google Calendar, Google Antigravity, Android Messages, WhatsApp and Telegram",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.webgrafia.deskbox",
    "productName": "Deskbox",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/ui/assets/icon.png"
    },
    "linux": {
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/ui/assets/icon.png"
    }
  },
  "keywords": [
    "rambox",
    "workspace",
    "electron",
    "whatsapp",
    "telegram",
    "gmail",
    "calendar",
    "antigravity",
    "android-messages"
  ],
  "author": "Deskbox",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  }
}
